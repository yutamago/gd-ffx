<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>GdFfx</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- arrays up to 2 MiB in the young generation (from 85,000 bytes they go on the large object
         heap, collected with gen2). Only where .NET reads this project's runtimeconfig.json:
         Godot run on the project folder starts it with the editor's own, so not there
         (docs/running.md, "Benchmark") -->
    <RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="2097152" />
  </ItemGroup>
</Project>
