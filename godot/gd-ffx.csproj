<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>GdFfx</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- arrays up to 2 MiB in the young generation: the frame's effect geometry and the snapshots,
         copied out of the extension each update, die young; on the large object heap (from
         85,000 bytes) each one counted towards a full collection (docs/running.md, "Benchmark") -->
    <RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="2097152" />
  </ItemGroup>
</Project>
