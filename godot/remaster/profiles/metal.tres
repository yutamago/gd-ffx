[resource]
script = ExtResource("1")
Title = "Metal"
Note = "Bare and worn metal: the brighter parts metallic (darker ones rust and dirt), smoother, worn edges. Tuned on znkd08_metal_01 to _03, znkd08_streetlamp_01 and Bevelle's machina (bvyt00). The anisotropy is tuned but off: + map, Anisotropy for brushed metal (the grain across the scratches)."
