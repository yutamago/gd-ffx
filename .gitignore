# Never commit game data: the game's files, archives, anything extracted or
# converted from them, saves, captures. gd-ffx reads the player's own copy at
# run time.
*.vbf
*.exe
*.dll
*.fsb
*.fev
*.phyre
*.dds
*.bin
*.dat
*.sav
*.webm
/game/
/extracted/
/captures/
/saves/
# imported classic content (made from the player's copy on their machine)
/godot/classic/

# exports (tools/export.sh)
/build/

# Godot
/godot/.godot/
# made by the editor (or tools/export.sh: a .NET export needs one)
/godot/*.sln
/godot/android/
*.pck
*.tmp

# .NET
bin/
obj/
*.user
.vs/
.idea/

# Rust
/rust/target/
# a local cargo config (patches to a local ffx-rust checkout)
/.cargo/

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# agent worktrees
/.claude/

# the remaster editor's map edit scenes (made per map in the editor; they build the classic map at run time)
/godot/remaster/edit/
